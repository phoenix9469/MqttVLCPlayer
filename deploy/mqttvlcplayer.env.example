# /etc/mqttvlcplayer.env 로 복사한 뒤 값을 채우고 권한을 600으로 설정하세요.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 영상 폴더 기본값 (웹 UI에서 바꾸면 config.json에 저장되어 우선 적용)
NAS_FOLDER=/mv

# 웹 UI. WEB_USERNAME을 설정하면 HTTP Basic 인증을 요구합니다.
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_USERNAME=
WEB_PASSWORD=

# TV 전원 상태 조회 주기(초), 0이면 조회 안 함
STATUS_INTERVAL=60

# 재생 화면 좌측 상단 시계 (strftime 형식, 비우면 표시 안 함)
CLOCK_FORMAT=%H:%M
# 시계 글자 크기(px), 0이면 자동
CLOCK_SIZE=0
# 시계 글꼴 (fc-list : family 로 이름 확인, 비우면 기본 글꼴)
CLOCK_FONT=

# 재생기: mpv(기본, 하드웨어 디코딩) 또는 vlc
VIDEO_PLAYER=mpv
# Ivy Bridge(HD 4000) 등 구형 Intel GPU는 VA-API 드라이버를 i965로 지정
LIBVA_DRIVER_NAME=i965
# mpv 하드웨어 디코딩 방식(auto-safe, vaapi, vaapi-copy, no), 미리 읽기(초), 추가 옵션
MPV_HWDEC=auto-safe
MPV_CACHE_SECS=10
MPV_EXTRA_ARGS=
# VIDEO_PLAYER=vlc일 때만 사용: 영상 재생 버퍼(ms)와 추가 VLC 옵션
VLC_CACHING=3000
VLC_EXTRA_ARGS=

# 알림 소리 / TTS
SOUNDS_FOLDER=/home/user/MqttVLCPlayer/sounds
SOUND_VOLUME=100
# 시도할 TTS 엔진 순서: piper(piper-plus), espeak(espeak-ng, 대체용)
TTS_ENGINES=piper,espeak
# ja, en 또는 auto(가나·한자가 있으면 ja, 아니면 en)
TTS_LANG=auto
# 말하는 속도 배율 (1.0 보통, 1.2 = 20% 빠르게, 0.8 = 20% 느리게, 0.5~2.0)
TTS_SPEED=1.0
# 기본 목소리와, 추가로 고를 수 있는 목소리 목록(쉼표 구분)
PIPER_MODEL=ja_JP-tsukuyomi-chan-medium
PIPER_VOICES=ja_JP-css10-6lang-medium
# 화자가 여러 명인 모델에서 쓸 기본 화자 번호
PIPER_SPEAKER=0
PIPER_DATA_DIR=/home/user/MqttVLCPlayer/piper-models
